--[[  

     Death Teleport | 사망 위치 복귀
     by ZXC's Hub

  ]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

getgenv().DeathReturnEnabled = true

if getgenv().DeathReturnConnections then
    for _, conn in ipairs(getgenv().DeathReturnConnections) do
        if conn.Connected then conn:Disconnect() end
    end
end
getgenv().DeathReturnConnections = {}
getgenv().LastDeathPosition = nil

local Connections = getgenv().DeathReturnConnections

local function HookDeath(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    local root = character:WaitForChild("HumanoidRootPart", 5)
    if not humanoid or not root then return end

    local healthConn = humanoid.HealthChanged:Connect(function(health)
        if health <= 0 and getgenv().DeathReturnEnabled then
            if root and root.Parent then
                getgenv().LastDeathPosition = root.CFrame
            end
        end
    end)
    table.insert(Connections, healthConn)

    local diedConn = humanoid.Died:Connect(function()
        if getgenv().DeathReturnEnabled and root and root.Parent then
            getgenv().LastDeathPosition = root.CFrame
        end
    end)
    table.insert(Connections, diedConn)
end

local function OnRespawn(character)
    if not getgenv().DeathReturnEnabled then return end
    if not getgenv().LastDeathPosition then return end

    local humanoid = character:WaitForChild("Humanoid", 5)
    local root = character:WaitForChild("HumanoidRootPart", 5)
    if not humanoid or not root then return end

    repeat task.wait() until root.Parent and humanoid.RootPart == root

    local targetCFrame = getgenv().LastDeathPosition
    local startTime = tick()

    while tick() - startTime < 0.5 do
        if not getgenv().DeathReturnEnabled then break end
        if not root.Parent or humanoid.Health <= 0 then break end
        root.CFrame = targetCFrame
        RunService.Heartbeat:Wait()
    end
end

if LocalPlayer.Character then
    HookDeath(LocalPlayer.Character)
end

local addedConn = LocalPlayer.CharacterAdded:Connect(function(character)
    task.spawn(OnRespawn, character)
    HookDeath(character)
end)
table.insert(Connections, addedConn)

    local entry = Instance.new("Frame")
    entry.Size = UDim2.new(1, 0, 0, 62)
    entry.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    entry.BorderSizePixel = 0
    entry.Parent = scrollFrame

    local ec = Instance.new("UICorner")
    ec.CornerRadius = UDim.new(0, 8)
    ec.Parent = entry

    -- 디스플레이 이름
    local displayLabel = Instance.new("TextLabel")
    displayLabel.Size = UDim2.new(1, -120, 0, 28)
    displayLabel.Position = UDim2.new(0, 8, 0, 4)
    displayLabel.BackgroundTransparency = 1
    displayLabel.Font = Enum.Font.GothamBold
    displayLabel.TextSize = 13
    displayLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    displayLabel.TextXAlignment = Enum.TextXAlignment.Left
    displayLabel.TextTruncate = Enum.TextTruncate.AtEnd
    displayLabel.Parent = entry

    -- 유저 이름 (작게)
    local usernameLabel = Instance.new("TextLabel")
    usernameLabel.Size = UDim2.new(1, -120, 0, 20)
    usernameLabel.Position = UDim2.new(0, 8, 0, 34)
    usernameLabel.BackgroundTransparency = 1
    usernameLabel.Font = Enum.Font.Gotham
    usernameLabel.TextSize = 11
    usernameLabel.TextColor3 = Color3.fromRGB(140, 140, 140)
    usernameLabel.TextXAlignment = Enum.TextXAlignment.Left
    usernameLabel.TextTruncate = Enum.TextTruncate.AtEnd
    usernameLabel.Parent = entry

    -- 이름 설정
    local displayName = player.DisplayName
    if displayName ~= player.Name then
        displayLabel.Text = displayName
        usernameLabel.Text = "@" .. player.Name
    else
        displayLabel.Text = player.Name
        usernameLabel.Text = ""
    end

    -- 오빗 버튼
    local orbitBtn = Instance.new("TextButton")
    orbitBtn.Size = UDim2.new(0, 44, 0, 28)
    orbitBtn.Position = UDim2.new(1, -108, 0.5, -14)
    orbitBtn.BackgroundColor3 = Color3.fromRGB(40, 100, 180)
    orbitBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    orbitBtn.Text = "GO"
    orbitBtn.Font = Enum.Font.GothamBold
    orbitBtn.TextSize = 11
    orbitBtn.BorderSizePixel = 0
    orbitBtn.Parent = entry

    local obc = Instance.new("UICorner")
    obc.CornerRadius = UDim.new(0, 6)
    obc.Parent = orbitBtn

    -- 리스트 버튼
    local listBtn = Instance.new("TextButton")
    listBtn.Size = UDim2.new(0, 56, 0, 28)
    listBtn.Position = UDim2.new(1, -58, 0.5, -14)
    listBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    listBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    listBtn.Text = "--"
    listBtn.Font = Enum.Font.GothamBold
    listBtn.TextSize = 11
    listBtn.BorderSizePixel = 0
    listBtn.Parent = entry

    local lbc = Instance.new("UICorner")
    lbc.CornerRadius = UDim.new(0, 6)
    lbc.Parent = listBtn

    playerStatus[player.Name] = playerStatus[player.Name] or 0

    local function UpdateListBtn()
        local status = playerStatus[player.Name] or 0
        listBtn.BackgroundColor3 = GetStatusColor(status)
        listBtn.Text = GetStatusText(status)
        local nameColor = GetStatusNameColor(status)
        displayLabel.TextColor3 = nameColor
        usernameLabel.TextColor3 = status == 0
            and Color3.fromRGB(140, 140, 140)
            or nameColor
    end

    local function UpdateOrbitBtn()
        if orbitTarget == player and not allOrbitActive then
            orbitBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
            orbitBtn.Text = "STOP"
        elseif orbitTarget == player and allOrbitActive then
            orbitBtn.BackgroundColor3 = Color3.fromRGB(180, 80, 255)
            orbitBtn.Text = "GO"
        else
            orbitBtn.BackgroundColor3 = Color3.fromRGB(40, 100, 180)
            orbitBtn.Text = "GO"
        end
    end

    listBtn.MouseButton1Click:Connect(function()
        local current = playerStatus[player.Name] or 0
        playerStatus[player.Name] = (current + 1) % 3
        UpdateListBtn()
    end)

    orbitBtn.MouseButton1Click:Connect(function()
        if allOrbitActive then return end
        if orbitTarget == player then
            StopOrbit(false)
        else
            StartOrbitTarget(player, false)
        end
        UpdateAllEntryButtons()
    end)

    UpdateListBtn()
    UpdateOrbitBtn()

    playerEntries[player.Name] = {
        entry = entry,
        UpdateListBtn = UpdateListBtn,
        UpdateOrbitBtn = UpdateOrbitBtn,
    }
end

local function RemovePlayerEntry(player)
    if playerEntries[player.Name] then
        playerEntries[player.Name].entry:Destroy()
        playerEntries[player.Name] = nil
    end
    playerStatus[player.Name] = nil
    if orbitTarget == player then
        if allOrbitActive then
            local next = GetNextTarget(player)
            if next then StartOrbitTarget(next, true) else StopOrbit(false) end
        else
            StopOrbit(false)
        end
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    CreatePlayerEntry(player)
end

Players.PlayerAdded:Connect(CreatePlayerEntry)
Players.PlayerRemoving:Connect(RemovePlayerEntry)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    if orbitTarget and not allOrbitActive then
        StartOrbitTarget(orbitTarget, false)
    elseif allOrbitActive then
        local next = GetNextTarget(nil)
        if next then StartOrbitTarget(next, true) end
    end
end)


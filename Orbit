-- =====================
-- 리스트 상태
-- 0 = 없음, 1 = 화이트리스트(제외), 2 = 블랙리스트(대상만)
-- =====================
local playerStatus = {}

local function GetStatusColor(status)
    if status == 1 then return Color3.fromRGB(40, 160, 80)
    elseif status == 2 then return Color3.fromRGB(200, 60, 60)
    else return Color3.fromRGB(50, 50, 50) end
end

local function GetStatusText(status)
    if status == 1 then return "WL"
    elseif status == 2 then return "BL"
    else return "--" end
end

local function GetStatusNameColor(status)
    if status == 1 then return Color3.fromRGB(100, 220, 130)
    elseif status == 2 then return Color3.fromRGB(220, 100, 100)
    else return Color3.fromRGB(220, 220, 220) end
end

local function IsOrbitTarget(playerName)
    local status = playerStatus[playerName] or 0
    local hasBlacklist = false
    for _, s in pairs(playerStatus) do
        if s == 2 then hasBlacklist = true break end
    end
    if status == 1 then return false
    elseif status == 2 then return true
    else return not hasBlacklist end
end

-- =====================
-- Orbit 로직
-- =====================
local orbitTarget = nil
local orbitAngle = 0
local orbitConnection = nil
local allOrbitActive = false
local deathConnection = nil
local orbitStartTime = 0
local timerConnection = nil
local playerEntries = {}
local savedPosition = nil

local function GetNextTarget(excludePlayer)
    local candidates = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if excludePlayer and player == excludePlayer then continue end
        if not IsOrbitTarget(player.Name) then continue end
        local char = player.Character
        if not char then continue end
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid and humanoid.Health > 0 then
            table.insert(candidates, player)
        end
    end
    if #candidates == 0 then return nil end
    return candidates[math.random(1, #candidates)]
end

local function UpdateAllEntryButtons()
    for _, e in pairs(playerEntries) do
        if e.UpdateOrbitBtn then e.UpdateOrbitBtn() end
    end
end

local function NotifyOrbitStopped()
    task.spawn(function()
        for i = 1, 4 do
            statusLabel.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
            statusLabel.Text = "오빗 종료됨!"
            statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            task.wait(0.2)
            statusLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            task.wait(0.2)
        end
        statusLabel.Text = "대기중"
        statusLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
        statusLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    end)
end

local function StopOrbit(silent)
    allOrbitActive = false
    orbitTarget = nil

    if orbitConnection then orbitConnection:Disconnect() orbitConnection = nil end
    if deathConnection then deathConnection:Disconnect() deathConnection = nil end
    if timerConnection then timerConnection:Disconnect() timerConnection = nil end

    local myChar = LocalPlayer.Character
    local humanoid = myChar and myChar:FindFirstChild("Humanoid")
    if humanoid then Camera.CameraSubject = humanoid end
    Camera.CameraType = Enum.CameraType.Custom

    if savedPosition then
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myRoot then myRoot.CFrame = savedPosition end
        savedPosition = nil
    end

    timerLabel.Text = ""
    allOrbitBtn.Text = "전체 오빗 시작"
    allOrbitBtn.BackgroundColor3 = Color3.fromRGB(140, 60, 200)

    if not silent then
        NotifyOrbitStopped()
    else
        statusLabel.Text = "대기중"
        statusLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
    end

    UpdateAllEntryButtons()
end

local function StartOrbitTarget(targetPlayer, fromAllOrbit)
    if orbitConnection then orbitConnection:Disconnect() orbitConnection = nil end
    if deathConnection then deathConnection:Disconnect() deathConnection = nil end
    if timerConnection then timerConnection:Disconnect() timerConnection = nil end

    local targetChar = targetPlayer.Character
    if not targetChar then
        if fromAllOrbit then
            local next = GetNextTarget(targetPlayer)
            if next then task.spawn(StartOrbitTarget, next, true) end
        end
        return
    end

    local targetHumanoid = targetChar:FindFirstChild("Humanoid")
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetHumanoid or not targetRoot then return end

    if not orbitTarget then
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myRoot then savedPosition = myRoot.CFrame end
    end

    orbitTarget = targetPlayer
    orbitAngle = 0
    orbitStartTime = tick()

    Camera.CameraSubject = targetHumanoid
    Camera.CameraType = Enum.CameraType.Custom

    local displayName = targetPlayer.DisplayName
    local showName = displayName ~= targetPlayer.Name
        and displayName .. "(" .. targetPlayer.Name .. ")"
        or targetPlayer.Name

    if fromAllOrbit then
        statusLabel.Text = "전체오빗: " .. showName
        statusLabel.TextColor3 = Color3.fromRGB(200, 100, 255)
    else
        statusLabel.Text = showName .. " 오빗 중"
        statusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
    end
    statusLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 30)

    UpdateAllEntryButtons()

    deathConnection = targetHumanoid.Died:Connect(function()
        if fromAllOrbit and allOrbitActive then
            task.wait(0.3)
            local next = GetNextTarget(targetPlayer)
            if next then StartOrbitTarget(next, true) else StopOrbit(false) end
        elseif not fromAllOrbit then
            StopOrbit(false)
        end
    end)

    if fromAllOrbit then
        timerConnection = RunService.Heartbeat:Connect(function()
            if not allOrbitActive then return end
            local elapsed = tick() - orbitStartTime
            local remaining = math.ceil(ORBIT_MAX_TIME - elapsed)
            if remaining > 0 then
                timerLabel.Text = "교체까지 " .. remaining .. "초"
            else
                timerLabel.Text = ""
                local next = GetNextTarget(orbitTarget)
                if next then StartOrbitTarget(next, true) else StopOrbit(false) end
            end
        end)
    end

    orbitConnection = RunService.Heartbeat:Connect(function()
        if not orbitTarget then return end
        local char = orbitTarget.Character
        if not char then return end
        local humanoid = char:FindFirstChild("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not humanoid or humanoid.Health <= 0 or not root then return end
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        orbitAngle = orbitAngle + math.rad(ORBIT_SPEED) / 60

        local rotCFrame = CFrame.Angles(0, orbitAngle, 0)
        local distOffset = CFrame.new(ORBIT_DISTANCE, 0, 0)

        local predictedPos = Vector3.new(
            root.Position.X + humanoid.MoveDirection.X * root.AssemblyLinearVelocity.Magnitude / 2.75,
            root.Position.Y,
            root.Position.Z + humanoid.MoveDirection.Z * root.AssemblyLinearVelocity.Magnitude / 2.75
        )

        myRoot.CFrame = CFrame.new(predictedPos) * rotCFrame * distOffset
    end)
end

allOrbitBtn.MouseButton1Click:Connect(function()
    if allOrbitActive then
        StopOrbit(false)
    else
        local target = GetNextTarget(nil)
        if target then
            allOrbitActive = true
            allOrbitBtn.Text = "전체 오빗 중지"
            allOrbitBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
            StartOrbitTarget(target, true)
        else
            statusLabel.Text = "오빗 가능한 플레이어 없음"
            statusLabel.TextColor3 = Color3.fromRGB(255, 180, 0)
            task.delay(2, function()
                if not allOrbitActive then
                    statusLabel.Text = "대기중"
                    statusLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
                end
            end)
        end
    end
end)

